# Required production values. Copy this file to an ignored local file and replace every placeholder.
APP_ENV=production
POSTGRES_DB=agentscope
POSTGRES_USER=agentscope
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgresql+asyncpg://agentscope:replace-with-a-long-random-alphanumeric-password@postgres:5432/agentscope
CORS_ORIGINS=https://agentscope.example.com
NEXT_PUBLIC_API_URL=https://api.agentscope.example.com

# Safe operational defaults.
REDIS_URL=redis://redis:6379/0
DEPENDENCY_PROBE_TIMEOUT_SECONDS=1
EVALUATION_RECOVERY_INTERVAL_SECONDS=60
MONITORING_MAX_CATCHUP_WINDOWS=24
MONITORING_MAX_DRIFT_CHECKS_PER_SCAN=100
BISECTION_MAX_COMMIT_RANGE=500
BISECTION_WORK_ROOT=/tmp/agentscope-bisection-worktrees
BISECTION_EXECUTION_MAX_ATTEMPTS=3
WORKER_PROCESSES=2
WORKER_THREADS=4
BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
WEB_HOST_PORT=3000
AGENTSCOPE_IMAGE_TAG=local

# Optional. Leave empty unless OpenAI-backed judge execution is needed.
OPENAI_API_KEY=
